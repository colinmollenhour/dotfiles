#!/usr/bin/env bash
# cup-recipes — print the 12 cup recipes agents actually need.
# Prefer this over loading the full clickup skill (~95KB) or cup --help.
set -euo pipefail

cat <<'EOF'
# cup recipes (token-cheap cheat sheet)

## Auth
cup auth                          # must succeed; else cup init

## Read
cup task <id|url>                 # full task JSON-ish view
cup task <id> --json              # machine-readable when supported
cup comments <id>
cup sprints                       # find sprint list ids
cup members                       # resolve assignee ids
cup fields <id>                   # custom fields on a task
cup lists --space <name|id>       # list structure

## Write
cup create -n "Title" --list sprint:current \
  --description-file /abs/body.md \
  --assignee <userId> \
  --priority normal \
  --custom-item-id <taskTypeId> \
  --field "Value Stream" Bug \
  --field "Requested By/Affects Clients" RSF

# Subtask: --parent must be LONG form (short -p is global --profile)
cup create -n "Subtask" --parent <parentTaskId>

cup update <id> --status "in progress" --assignee <userId>
cup field <id> --set "Value Stream" Bug
cup comment <id> -m "note text"
# long comment:
cup comment <id> --message-file /abs/note.md

## Search / sprint
cup tasks --list sprint:current
cup tasks --assignee me --status open

## Gotchas
- `-p` on create is NOT parent → use `--parent`
- Bug work needs BOTH custom item type Bug AND Value Stream=Bug
- Prefer list IDs over names
- Do NOT load the full clickup skill encyclopedia for these recipes
EOF
